# Example Nginx server block for the public-facing reverse proxy.
# Place this in /etc/nginx/sites-available/sap-bdc.conf on the external
# Nginx server, then symlink to sites-enabled and `nginx -s reload`.
#
# Assumes the VPS is reachable from the Nginx host via WireGuard at
# 10.0.0.2 (adjust to your peer IP). Adjust server_name to your domain.

upstream sap_bdc_upstream {
    # WireGuard IP of the VPS running the sap-bdc container.
    server 10.0.0.2:8000;
    keepalive 16;
}

server {
    listen 443 ssl http2;
    server_name sap-bdc.example.com;

    # Use your existing cert paths.
    ssl_certificate     /etc/letsencrypt/live/sap-bdc.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sap-bdc.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Parquet files can be tens of MB; don't buffer them through nginx
    # and allow long-running downloads.
    proxy_buffering         off;
    proxy_read_timeout      600s;
    proxy_send_timeout      600s;
    client_max_body_size    100m;

    # Big enough headers for Delta Sharing signed URLs.
    large_client_header_buffers 4 16k;

    location / {
        proxy_pass http://sap_bdc_upstream;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_set_header   Connection        "";
    }
}

# Plain-HTTP server redirects to HTTPS.
server {
    listen 80;
    server_name sap-bdc.example.com;
    return 301 https://$host$request_uri;
}
