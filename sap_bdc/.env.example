# Bearer token Databricks uses to authenticate against this service.
# Generate with: openssl rand -hex 32
SAP_BDC_TOKEN=changeme

# Public base URL of this service (used in Delta Sharing file URLs and profile.json).
# When deployed as a Databricks App this is set automatically from the app URL.
HOST=http://localhost:8080

# Directory where Delta Lake tables are written.
# Relative paths are resolved from the sap_bdc/ directory.
DATA_DIR=./data/delta
